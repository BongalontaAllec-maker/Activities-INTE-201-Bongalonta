public class AtmTransactionAuthorizer {
    public static void main(String[] args) {
        String inputUser = "user123";
        int inputPin = 1234;
        double balance = 25000.0;
        double withdrawalAmount = 5000.0;

        String targetUser = "user123";
        int targetPin = 1234;

        System.out.println("========================================");
        System.out.println("       ATM TRANSACTION AUTHORIZER       ");
        System.out.println("========================================");

        if (inputUser.equals(targetUser)) {
            if (inputPin == targetPin) {
                String tier;
                if (balance >= 50000.0) {
                    tier = "Platinum";
                } else if (balance >= 20000.0) {
                    tier = "Gold";
                } else if (balance >= 10000.0) {
                    tier = "Silver";
                } else {
                    tier = "Bronze";
                }

                double dailyLimit = 0.0;
                if (tier.equals("Platinum")) {
                    dailyLimit = 20000.0;
                } else if (tier.equals("Gold")) {
                    dailyLimit = 10000.0;
                } else if (tier.equals("Silver")) {
                    dailyLimit = 5000.0;
                } else {
                    dailyLimit = 2000.0;
                }

                if (withdrawalAmount <= balance) {
                    if (withdrawalAmount <= dailyLimit) {
                        double feePercentage = 0.0;
                        switch (tier) {
                            case "Platinum":
                                feePercentage = 0.0;
                                break;
                            case "Gold":
                                feePercentage = 0.01;
                                break;
                            case "Silver":
                                feePercentage = 0.02;
                                break;
                            case "Bronze":
                                feePercentage = 0.03;
                                break;
                        }

                        double fee = withdrawalAmount * feePercentage;
                        double totalDeduction = withdrawalAmount + fee;

                        if (totalDeduction <= balance) {
                            System.out.println("Status          : APPROVED");
                            System.out.println("Account Tier    : " + tier);
                            System.out.println("Withdrawal      : P" + withdrawalAmount);
                            System.out.println("Transaction Fee : P" + fee);
                            System.out.println("New Balance     : P" + (balance - totalDeduction));
                        } else {
                            System.out.println("Status          : DENIED");
                            System.out.println("Reason          : Insufficient funds to cover withdrawal amount plus transaction fee.");
                        }
                    } else {
                        System.out.println("Status          : DENIED");
                        System.out.println("Reason          : Withdrawal amount exceeds tier-dependent daily limit.");
                    }
                } else {
                    System.out.println("Status          : DENIED");
                    System.out.println("Reason          : Insufficient account balance.");
                }
            } else {
                System.out.println("Status          : DENIED");
                System.out.println("Reason          : Incorrect 4-digit PIN.");
            }
        } else {
            System.out.println("Status          : DENIED");
            System.out.println("Reason          : Invalid username.");
        }
        System.out.println("========================================");
    }
}
