public class ClassRankingSystem {

    static class Student {
        String name;
        double[] quizzes;

        Student(String name, double[] quizzes) {
            this.name = name;
            this.quizzes = quizzes;
        }

        double getAverage() {
            double total = 0;

            for (int i = 0; i < quizzes.length; i++) {
                total += quizzes[i];
            }

            return total / quizzes.length;
        }
    }

    // Custom linear search to find a student's rank
    static int linearSearch(Student[] students, String target) {
        for (int i = 0; i < students.length; i++) {
            if (students[i].name.equalsIgnoreCase(target)) {
                return i + 1;
            }
        }

        return -1;
    }

    // Custom bubble sort to rank students by average
    static void sortStudents(Student[] students) {
        for (int i = 0; i < students.length - 1; i++) {
            for (int j = 0; j < students.length - 1 - i; j++) {
                if (students[j].getAverage()
                        < students[j + 1].getAverage()) {

                    Student temp = students[j];
                    students[j] = students[j + 1];
                    students[j + 1] = temp;
                }
            }
        }
    }

    public static void main(String[] args) {

        Student[] students = {
            new Student("Alex", new double[]{90, 85, 88, 92}),
            new Student("Brian", new double[]{80, 85, 82, 83}),
            new Student("Carlo", new double[]{95, 90, 93, 92}),
            new Student("David", new double[]{80, 85, 82, 83}),
            new Student("Ethan", new double[]{88, 87, 90, 85})
        };

        // Sort the students from highest to lowest average
        sortStudents(students);

        System.out.println("========== CLASS LEADERBOARD ==========");
        System.out.printf("%-10s %-10s %-10s%n",
                "Rank", "Name", "Average");
        System.out.println("---------------------------------------");

        int rank = 1;

        for (int i = 0; i < students.length; i++) {

            // Students with the same average share the same rank
            if (i > 0 && students[i].getAverage()
                    == students[i - 1].getAverage()) {
                // Keep the previous rank
            } else {
                rank = i + 1;
            }

            System.out.printf("%-10d %-10s %-10.2f%n",
                    rank, students[i].name,
                    students[i].getAverage());
        }

        // Search for a student using their name
        String target = "David";
        int position = linearSearch(students, target);

        System.out.println("\nSearching for: " + target);

        if (position != -1) {
            System.out.println("Student found at position: " + position);
            System.out.println("Rank: " + students[position - 1].name
                    + " has an average of "
                    + students[position - 1].getAverage());
        } else {
            System.out.println("Student not found.");
        }
    }
}
