public class SimpleGradeClassifier {
    public static void main(String[] args) {
        int score = 85;

        System.out.println("========================================");
        System.out.println("         SIMPLE GRADE CLASSIFIER        ");
        System.out.println("========================================");
        System.out.println("Test Score      : " + score);
        
        if (score >= 60) {
            System.out.println("Classification  : PASSED");
        } else {
            System.out.println("Classification  : FAILED");
        }
        
        score = 45;
        System.out.println("----------------------------------------");
        System.out.println("Test Score      : " + score);
        
        if (score >= 60) {
            System.out.println("Classification  : PASSED");
        } else {
            System.out.println("Classification  : FAILED");
        }
        System.out.println("========================================");
    }
}
