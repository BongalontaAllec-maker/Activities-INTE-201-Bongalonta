public class PrecedencePuzzleSolver {
    public static void main(String[] args) {
        int a = 5;
        boolean result1 = ++a > 5 && a * 2 < 15;

        int b = 10;
        boolean result2 = b++ == 10 && ++b > 11;

        int c = 3;
        boolean result3 = c++ + ++c > 6 && c * 2 != 14;

        System.out.println("========================================");
        System.out.println("        PRECEDENCE PUZZLE SOLVER        ");
        System.out.println("========================================");
        System.out.println("Expression 1 Result : " + result1);
        System.out.println("Expression 2 Result : " + result2);
        System.out.println("Expression 3 Result : " + result3);
        System.out.println("========================================");
    }
}
