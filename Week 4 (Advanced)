public class Main {
    public static void main(String[] args) {

        System.out.println("===== Pattern Generator With Early Exit =====");

        int size = 4;

        for (int i = 1; i <= size; i++) {

            if (i == 3) {
                continue;
            }

            for (int j = 1; j <= size; j++) {

                if (j == 4) {
                    break;
                }

                if (j <= i) {
                    System.out.print("* ");
                }
            }

            System.out.println();
        }
    }
}
