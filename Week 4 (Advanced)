public class PatternGeneratorEarlyExit {
    public static void main(String[] args) {
        int size = 5;

        System.out.println("========================================");
        System.out.println("    PATTERN GENERATOR WITH EARLY EXIT   ");
        System.out.println("========================================");

        for (int i = 1; i <= size; i++) {
            if (i == 3) {
                continue; 
            }
            
            for (int j = 1; j <= size; j++) {
                if (j > 3) {
                    break; 
                }
                System.out.print("* ");
            }
            System.out.println("(Row " + i + ")");
        }

        System.out.println("========================================");
    }
}
